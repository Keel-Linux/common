# rm apt proxy conf
/etc/apt/apt.conf.d/01proxy

# clean apt cache
/var/cache/apt/archives/
!/var/cache/apt/archives/partial

# clean tmp key files
/etc/apt/trusted.gpg~
/etc/apt/trusted.gpg.d/*.gpg~

# clean apt related logs
/var/log/dpkg.log
/var/log/bootstrap.log
/var/log/apt/term.log
/var/log/apt/history.log

# rm composer auth token
/root/.composer/auth.json
/var/www/.composer/auth.json

# rm composer cache
/root/.cache/composer
/var/www/.composer/cache

# rm common systemctl chroot workaround(s)
/usr/local/bin/service
/usr/local/bin/systemctl

# rm bashlib
/usr/local/src/tkl-bashlib

# rm tmp contents
~/tmp/*
~/tmp/.*

# rm the captured package pool a pinned build installed from, its apt
# source and its pin (decision 0012). The '~' prefix is a glob, so a build
# that used no pool passes over these three silently.
~/etc/apt/sources.list.d/keel-pool.sources
~/etc/apt/preferences.d/keel-pool
~/keel-pool
