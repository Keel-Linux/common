# rm apt proxy conf
/etc/apt/apt.conf.d/01proxy

# clean apt cache
/var/cache/apt/archives/
!/var/cache/apt/archives/partial

# clean tmp key files
/etc/apt/trusted.gpg~
/etc/apt/trusted.gpg.d/*.gpg~

# clean apt related logs
/var/log/dpkg.log
/var/log/bootstrap.log
/var/log/apt/term.log
/var/log/apt/history.log

# rm composer auth token
/root/.composer/auth.json
/var/www/.composer/auth.json

# rm composer cache
/root/.cache/composer
/var/www/.composer/cache

# rm common systemctl chroot workaround(s)
/usr/local/bin/service
/usr/local/bin/systemctl

# rm bashlib
/usr/local/src/tkl-bashlib

# rm the build time source of the project's own packages: the copy of the
# staging archive a layer recipe installs inithooks, confconsole and keel
# from, the apt source that names it, and the keyring the build verified that
# archive with (tracker#7). None of the three is for an installed appliance:
# the staging key signs whatever the build host produced, so an image that
# kept it would carry trust in a nightly.
#
# A recipe's own conf script removes all three as well. This is the
# arrangement that holds whether or not a recipe remembers to, which is why it
# belongs here: the same defect has now had to be fixed in four recipes. The
# '~' prefix is a glob, so a build that used no staging archive passes over
# these silently. preferences.d/keel-staging is the build-only pin at 1001
# the recipes give the staging archive so it wins over TurnKey's 999 pin
# during their upgrade; left in an image, it would pin a source that is gone.
~/etc/apt/sources.list.d/keel-staging.list
~/etc/apt/preferences.d/keel-staging
~/etc/apt/keyrings/keel-staging-keyring.asc
~/srv/keel-apt

# rm tmp contents
~/tmp/*
~/tmp/.*

# rm the captured package pool a pinned build installed from, its apt
# source and its pin (decision 0012). The '~' prefix is a glob, so a build
# that used no pool passes over these three silently.
~/etc/apt/sources.list.d/keel-pool.sources
~/etc/apt/preferences.d/keel-pool
~/keel-pool

# rm every private key the build generated or a package shipped (keel-core#8).
# Every image built from a layer holds the same bytes, so a key left here is
# one every machine shares and anyone who downloads the layer has: the SSH
# host keys openssh-server makes at install, the certificate and key
# turnkey-ssl ships and its postinst copies into /etc/ssl/private, Webmin's
# miniserv.pem (unused: miniserv.conf reads /etc/ssl/private/cert.pem), and
# the snakeoil pair ssl-cert makes for PostgreSQL and Apache. The machine
# generates its own before any service reads them (inithooks,
# keel-host-keys.service), and bt-layer refuses a layer that still carries
# one. turnkey-ssl's own copy is removed from the layer too, but not kept
# out of an installed machine: its postinst copies it into /etc/ssl/private
# under sh -e whenever that is empty, so excluding it would fail a later
# install of the package. It is public in the package anyway; what matters is
# that no service reads it, which keel-host-keys ensures.
~/etc/ssh/ssh_host_*_key
~/etc/ssh/ssh_host_*_key.pub
~/etc/ssl/private/cert.key
~/etc/ssl/private/cert.pem
~/etc/ssl/private/ssl-cert-snakeoil.key
~/etc/ssl/certs/ssl-cert-snakeoil.pem
~/etc/webmin/miniserv.pem
~/usr/share/turnkey-ssl/cert.key
~/usr/share/turnkey-ssl/cert.pem
