/* The kernel, the initrd, firmware, the bootloaders and the installer are
   not here: they are in plans/keel-boot, which only the boot layer the ISO
   is made from installs (handbook decision 0052). A layer built from this
   plan is a container's: it runs on the host's kernel. systemd is the
   init, which plans/boot used to bring. */
systemd
#ifdef DEBIAN
systemd-sysv
#endif
#include <net>
#include <console>

wget
curl
rsync
zstd

keel-archive-keyring    /* the key of archive.keellinux.org, overlays/turnkey.d/keel-apt */

lvm2                    /* webmin-lvm depends; the installer recommends */
file

confconsole
kbd                     /* confconsole recommends */
resolvconf              /* confconsole recommends */

dbus                    /* dbus installed by default since v18.x */

/* tklbam, hubdns and webmin-tklbam are not installed: backup is Keel Backup
   (handbook decision 0040) and DNS registration is Keel Cloud, and neither
   turnkey-pypy2 nor py3curl-wrapper, which only they pulled in, is wanted */
inithooks
turnkey-sysinfo
turnkey-version
turnkey-ssl

cron
cron-apt

etckeeper
git

lsb-release
locales
localepurge
mawk
man-db
screen
dtach
nano
ntpsec
ncurses-term            /* support additional $TERM values */

webmin
webmin-authentic-theme
