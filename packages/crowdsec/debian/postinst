#!/bin/sh
# keel-overlay-crowdsec: leave CrowdSec in the state of a simple
# installation, both units disabled and stopped, whatever the postinst of
# crowdsec and crowdsec-firewall-bouncer did before it (they enable and
# start both, and register the bouncer with the local API).
#
# Only on the first installation ("configure" with no previous version):
# from then on the state is keel apply's, and an upgrade of this package
# must not undo it. An upgrade of either Debian package keeps it too,
# because their dh_installsystemd snippets re-enable a unit only while every
# link its state file records is present (deb-systemd-helper was-enabled),
# and deb-systemd-invoke never starts a disabled unit. Why this and not a
# mask or a preset alone: packages/README.md in Keel-Linux/common.
set -e

# the bouncer first: it talks to the local API crowdsec.service serves
UNITS="crowdsec-firewall-bouncer.service crowdsec.service"

if [ "$1" = configure ] && [ -z "$2" ]; then
    # removes the links and keeps the state file, which is what later
    # upgrades read as "the administrator disabled it". A failure fails the
    # configuration: a unit left enabled would be a state nobody chose.
    deb-systemd-helper disable $UNITS
    # deb-systemd-invoke honours policy-rc.d, as an image build needs; there
    # nothing was started, so there is nothing to stop
    if [ -d /run/systemd/system ]; then
        deb-systemd-invoke stop $UNITS
    fi
fi

#DEBHELPER#

exit 0
