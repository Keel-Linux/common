#!/bin/bash
# /usr/lib/keel-overlay-anubis/signing-key FILE
#
# Makes the key Anubis signs its challenge cookies with, the secret
# anubis_signing_key of the overlay manifest (handbook decision 0041:
# generate: required, shared: true), when FILE is not there yet. It is the
# hex encoded 32-byte ed25519 seed anubis reads from
# ED25519_PRIVATE_KEY_HEX_FILE, mode 0600, owned by whoever runs this
# (root, from keel-overlay-anubis-key.service).
#
# A key that is there is never replaced: on a node of a replicated set it
# is the primary's, which every node must hold so a visitor who solved the
# challenge on one is not challenged again on another. Nothing in an image
# build runs this, so no image carries a key: the first start of
# anubis@keel.service makes it, on the machine.
#
# KEEL_RANDOM (default /dev/urandom) exists for tests/anubis-signing-key.bats.
set -euo pipefail

if [ "$#" -ne 1 ]; then
    echo "usage: signing-key FILE" >&2
    exit 2
fi
key="$1"
random="${KEEL_RANDOM:-/dev/urandom}"

if [ -e "$key" ]; then
    echo "anubis: $key is there; left as it is"
    exit 0
fi

umask 077
draft="$(mktemp "$key.XXXXXX")"
trap 'rm -f -- "$draft"' EXIT
od -A n -v -t x1 -N 32 "$random" | tr -d ' \n' > "$draft"
if ! grep -qxE '[0-9a-f]{64}' "$draft"; then
    echo "anubis: $random gave not 64 hex digits; no key written" >&2
    exit 1
fi
# a hard link publishes the whole key at once and, unlike mv, never
# replaces a key written meanwhile
if ! ln "$draft" "$key" 2>/dev/null; then
    echo "anubis: $key was written meanwhile; left as it is"
    exit 0
fi
echo "anubis: generated the signing key $key"
