# keel-overlay-anubis: the environment of anubis@keel.service, the one
# Anubis of Keel Web (handbook decisions 0030 and 0042). Every flag of
# anubis can be set here by its upper-case name (anubis --help lists them).
#
# Behind Nginx, never at the edge: it listens on the IPv6 loopback only,
# port 8923, the port and check of the overlay manifest
# (/usr/share/keel/overlays/anubis.yaml). Nginx reaches it through
# /etc/nginx/snippets/keel-anubis.conf, and it hands what it allows back to
# Nginx on a unix socket, where Keel Web's sites are served to it (0042,
# "Real client IP").
BIND=[::1]:8923
BIND_NETWORK=tcp
TARGET=unix:///run/nginx/keel-app.sock

# The metrics go to a socket in the instance's runtime directory, so they
# take no port of the machine.
METRICS_BIND=/run/anubis/keel/metrics.sock
METRICS_BIND_NETWORK=unix

# The policy of Keel Web (0042): the drop-ins of an appliance first, then
# upstream's default, as the anubis package installs it. Anubis evaluates
# the list in order and the first rule that matches wins, so a drop-in of
# /etc/anubis/keel.d/ may allow what the default policy would challenge or
# deny (0062, the sync clients of the Nextcloud appliance).
POLICY_FNAME=/etc/anubis/keel-policy.yaml
SERVE_ROBOTS_TXT=false

# The signing key is /etc/anubis/keel.key, never this file:
# keel-overlay-anubis-key.service makes it before the first start when it
# is not there, and the unit hands it to anubis.
