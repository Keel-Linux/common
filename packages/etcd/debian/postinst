#!/bin/sh
# keel-overlay-etcd: leave etcd in the state of a simple installation,
# disabled and stopped, whatever etcd-server's own postinst did before it.
#
# Only on the first installation ("configure" with no previous version,
# which dpkg passes only when nothing of the package is left: a remove
# keeps it known through postrm, so a reinstall is an upgrade). From then
# on the state is keel apply's, and an upgrade of this package must not
# undo it. An upgrade of etcd-server keeps it too, because its
# dh_installsystemd snippet re-enables a unit only while every link its
# state file records is present (deb-systemd-helper was-enabled), and
# deb-systemd-invoke never starts a disabled unit. A unit preinst found
# enabled or running before the first installation is left as it is.
# Why this and not a mask or a preset alone: packages/README.md in
# Keel-Linux/common.
set -e

UNITS="etcd.service"
KEPT=/var/lib/keel-overlay-etcd/kept-units
FRESH=/var/lib/keel-overlay-etcd/no-member-before
DATA=/var/lib/etcd/default
# what keel reads as proof that the member is etcd-server's own
MARK=/var/lib/keel-overlay-etcd/package-member

if [ "$1" = configure ] && [ -z "$2" ]; then
    for unit in $UNITS; do
        if [ -f "$KEPT" ] && grep -qxF "$unit" "$KEPT"; then
            echo "keel-overlay-etcd: $unit was enabled or running before" \
                "the overlay was installed; left as it is" >&2
            continue
        fi
        # removes the links and keeps the state file, which is what later
        # upgrades read as "the administrator disabled it". A failure fails
        # the configuration: a unit left enabled would be a state nobody
        # chose.
        deb-systemd-helper disable "$unit"
        # deb-systemd-invoke honours policy-rc.d, as an image build needs;
        # there nothing was started, so there is nothing to stop
        if [ -d /run/systemd/system ]; then
            deb-systemd-invoke stop "$unit"
        fi
        # the member etcd-server's own start made in this transaction is
        # a lone cluster of one that no mesh formed: marked, so keel
        # removes it before it starts etcd for the mesh's cluster, and
        # no other (a member that was there before is never marked)
        if [ -f "$FRESH" ] && [ -d "$DATA/member" ]; then
            echo "keel-overlay-etcd: $DATA holds the lone member" \
                "etcd-server's own start made at its installation; keel" \
                "removes it when it joins this node to the mesh" >&2
            : > "$MARK"
        fi
    done
    rm -f "$KEPT" "$FRESH"
    rmdir "${KEPT%/*}" 2>/dev/null || :
fi

#DEBHELPER#

exit 0
