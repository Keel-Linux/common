#!/bin/sh
# keel-overlay-etcd: before the first installation, note which of the
# overlay's units were already enabled or running. postinst leaves those as
# they are, so installing the overlay on a machine that already ran etcd
# does not stop it. When etcd-server is installed in the same transaction it
# is only unpacked here, not yet configured, so its unit is neither enabled
# nor running, and postinst puts it in the simple state.
#
# Only on a live system, where systemd runs. An image build (a chroot, no
# /run/systemd/system) keeps nothing: there a unit enabled by an earlier
# apt run of the same build is the Debian package's doing, not an
# operator's, and must end disabled. postrm deletes the file on purge and
# abort-install, postinst once it has read it.
# packages/README.md in Keel-Linux/common.
set -e

UNITS="etcd.service"
KEPT=/var/lib/keel-overlay-etcd/kept-units
# etcd-server's postinst starts etcd, which makes a lone member of no
# cluster in its data directory; postinst removes it only if it was not
# there before this first installation (packages/README.md)
FRESH=/var/lib/keel-overlay-etcd/no-member-before
MEMBER=/var/lib/etcd/default/member

if [ "$1" = install ] && [ -z "$2" ]; then
    mkdir -p "${KEPT%/*}"
    : > "$KEPT"
    if [ ! -e "$MEMBER" ]; then
        : > "$FRESH"
    fi
    [ -d /run/systemd/system ] || UNITS=""
    for unit in $UNITS; do
        # is-enabled fails for a unit whose file is not there yet, which is
        # the answer wanted: nothing to keep
        if deb-systemd-helper --quiet is-enabled "$unit" 2>/dev/null; then
            echo "$unit" >> "$KEPT"
        elif systemctl --quiet is-active "$unit"; then
            echo "$unit" >> "$KEPT"
        fi
    done
fi

#DEBHELPER#

exit 0
