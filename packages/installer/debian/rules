#!/usr/bin/make -f
# The overlay manifest sits beside debian/ (docs/manifest-v1.md, "Kinds,
# and where each file lives") and is installed under the name keel looks
# it up by.

%:
	dh $@

execute_after_dh_auto_install:
	install -D -m 0644 manifest.yaml \
		debian/keel-overlay-installer/usr/share/keel/overlays/installer.yaml
