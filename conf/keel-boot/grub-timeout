#!/bin/bash -e

# The menu is hidden, not removed. On the Proxmox noVNC console, a serial
# console or EFI, a held Shift at power on is not reliable. Esc opens the
# menu, and the one second wait is the cost.
grub_conf=${GRUB_CONF:-/etc/default/grub}

sed -i 's/^GRUB_TIMEOUT=.*/GRUB_TIMEOUT=1/' "$grub_conf"
if grep -q '^GRUB_TIMEOUT_STYLE=' "$grub_conf"; then
    sed -i 's/^GRUB_TIMEOUT_STYLE=.*/GRUB_TIMEOUT_STYLE=hidden/' "$grub_conf"
else
    echo 'GRUB_TIMEOUT_STYLE=hidden' >> "$grub_conf"
fi
