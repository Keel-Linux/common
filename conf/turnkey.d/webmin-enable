#!/bin/bash -e

# An appliance is configured by its first boot scripts, and a web interface
# is not something it needs before then. So the unit does not start with the
# rest of the boot: it starts once inithooks reports that its boot scripts
# have run.
#
# The two conditions are triggering conditions, which systemd reads as an
# OR: the marker is there, or the image carries no inithooks at all and
# there is nothing to wait for. The path unit starts Webmin when the marker
# appears; it triggers a one shot that stays active afterwards, so it fires
# once and does not restart Webmin behind an administrator who stopped it.
#
# SYSTEMD_DIR, INITHOOKS_MARKER and INITHOOKS_RUN are test hooks; a build
# leaves them unset.

SYSTEMD_DIR=${SYSTEMD_DIR:-/etc/systemd/system}
INITHOOKS_MARKER=${INITHOOKS_MARKER:-/run/inithooks-complete}
INITHOOKS_RUN=${INITHOOKS_RUN:-/usr/lib/inithooks/run}

mkdir -p "$SYSTEMD_DIR/webmin.service.d"

cat > "$SYSTEMD_DIR/webmin.service.d/after-firstboot.conf" <<CONF
[Unit]
ConditionPathExists=|$INITHOOKS_MARKER
ConditionPathExists=|!$INITHOOKS_RUN
CONF

cat > "$SYSTEMD_DIR/webmin-after-firstboot.path" <<CONF
[Unit]
Description=Watch for the end of the first boot scripts, to start Webmin

[Path]
PathExists=$INITHOOKS_MARKER
Unit=webmin-after-firstboot.service

[Install]
WantedBy=multi-user.target
CONF

cat > "$SYSTEMD_DIR/webmin-after-firstboot.service" <<CONF
[Unit]
Description=Start Webmin now that the first boot scripts have run

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/systemctl --no-block start webmin.service
CONF

systemctl enable webmin
systemctl enable webmin-after-firstboot.path
