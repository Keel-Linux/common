#!/bin/bash -e

# MOTD_DIR, MOTD and SYSINFO_MOTD are test hooks; a build leaves them unset.
MOTD_DIR=${MOTD_DIR:-/etc/update-motd.d}
MOTD=${MOTD:-/etc/motd}
SYSINFO_MOTD=${SYSINFO_MOTD:-/usr/share/turnkey-sysinfo/contrib/motd}
mkdir -p $MOTD_DIR

# turnkey-sysinfo's motd prints a welcome, a blank line, the system
# information (a header, a blank line, the table) and, run as root as
# pam_motd runs it, a blank line and what tklbam-status prints: a block
# asking the operator to link this machine to a TurnKey Hub account, which
# a Keel appliance does not use (handbook decision 0020). The drop-in
# stops at that third blank line, by the shape of the output rather than
# by the words of the block, so that whatever the backup client prints
# there is left out too; tests/motd.bats.
cat >$MOTD_DIR/00-turnkey-sysinfo<<EOF
#!/bin/sh

$SYSINFO_MOTD | awk '/^[[:space:]]*\$/ { blank++ } blank < 3 { print } END { print "" }'
EOF

cat >$MOTD_DIR/07-check-inithooks<<'EOF'
#!/bin/sh

if grep RUN_FIRSTBOOT /etc/default/inithooks | grep -iq RUN_FIRSTBOOT=true; then
    if ! grep -q boot=casper /proc/cmdline || grep -q boot=live /proc/cmdline; then
        if [ -z "$TERM" ]; then
            _term=linux
        else
            _term=$TERM
        fi

        bold=$(tput -T $_term bold)
        normal=$(tput -T $_term sgr0)

        echo "    ${bold}WARNING:${normal} Firstboot hooks will rerun on reboot!"
        echo
    fi
fi
EOF

cat >$MOTD_DIR/08-turnkey-confconsole<<'EOF'
#!/bin/sh

if [ -z "$TERM" ]; then
    _term=linux
else
    _term=$TERM
fi

bold=$(tput -T $_term bold)
normal=$(tput -T $_term sgr0)

echo "    For Advanced commandline config run:    ${bold}confconsole${normal}"
echo
echo "  For more info see: https://github.com/Keel-Linux/confconsole"
echo
EOF

cat >$MOTD_DIR/10-nonpersistent-mode<<'EOF'
#!/bin/sh

if grep -q boot=casper /proc/cmdline || grep -q boot=live /proc/cmdline; then
    echo "  Warning: Non-persistent mode"
    echo
    echo "    The system is running in live non-persistent mode. Changes will"
    echo "    be lost on shutdown/reboot."
    echo
fi
EOF

rm -f $MOTD_DIR/{00-header,10-help-text} # incl. in ubuntu, not in debian

chmod +x $MOTD_DIR/*

# remove default Debian disclaimer
rm "$MOTD"
touch "$MOTD"
