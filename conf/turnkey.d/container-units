#!/bin/bash -e

# The units a Keel image boots with that cannot do their work in an
# unprivileged container. Found on a Keel Web LXC container on Proxmox,
# 2026-10-03: 'systemctl --failed' listed systemd-networkd-wait-online,
# sys-kernel-config.mount and sys-kernel-debug.mount, and ntpsec logged
# "ntp_adjtime: Operation not permitted" every few minutes.
#
# networkd. The image's network is ifupdown with dhcpcd
# (tkl-dhcpcd-ifupdown-glue, plans/net) and it carries no .network file, so
# systemd-networkd has nothing to manage and its wait-online, which the
# systemd package enables in network-online.target.wants, waits for a link
# networkd never brings up and fails at its timeout. Nothing in common,
# inithooks, confconsole or keel asks for networkd: inithooks' fence orders
# itself After=network-online.target, which ifupdown's networking.service
# reaches, and keel inspect reports network.managed_by as host or file.
# The socket is disabled too, so that nothing socket activates networkd
# behind the disabled service.
#
# Disabled is not enough, so the three are masked as well. An image leaves
# the build with an empty /etc/machine-id (buildtasks#15), so its first boot
# is a systemd first boot, which applies the presets: trixie's
# 90-systemd.preset says enable for systemd-networkd.service and
# systemd-networkd-wait-online.service, and the service's Also= reaches the
# socket. On the Keel Web image of step 10 (19.0-3) the socket and
# wait-online came back enabled that way, the socket started networkd and
# wait-online failed. A preset of Keel's saying disable would hold against
# that boot, but not against 'systemctl enable', which a package's
# maintainer script or an operator calls without reading presets; a mask
# holds against all of them, and neither preset-all nor enable can undo it.
# It is the right state here because nothing in the image is meant to run
# networkd at all: no .network file, no spec or keel apply that enables it
# (unlike the overlay units of packages/README.md, which keel apply turns
# on, and which are therefore never masked). An operator who wants
# networkd runs 'systemctl unmask' first, and the mask says so plainly.
# The mask is the link systemctl mask writes, made here so that the test
# hook SYSTEMD_DIR reaches it.
#
# ntpsec and the two kernel mounts. Each packaged unit already carries a
# capability condition (CAP_SYS_TIME for ntpd, CAP_SYS_RAWIO for the
# mounts), and in an unprivileged container it passes: the bounding set of
# the container's init is full inside its user namespace. What refuses the
# work is the kernel, which lets no user namespace but the initial one set
# the clock or mount debugfs and configfs, so ntpd runs and fails every
# adjustment and the mounts fail on the way to sysinit.target, which pulls
# both in as static units. A container's clock is the host's, and the
# host's debugfs and configfs are not the container's to mount, so the
# drop-in adds the condition the packaged units lack: the unit does not
# start in a container and starts as before on a VM or a bare install.
# systemd-modules-load. Found on the step 12 lean-core images, 2026-10-10:
# every image booted degraded with "Failed to initialize libkmod context:
# Operation not supported". The container core has no kernel and no
# /lib/modules (handbook decision 0052), but kmod ships
# /etc/modules-load.d/modules.conf, which satisfies a triggering condition
# of the packaged unit, and its CAP_SYS_MODULE condition passes in the user
# namespace for the reason above. A container cannot load modules: the host
# loads them. The same drop-in stops the unit in a container. The ISO boot
# layer (plans/keel-boot) boots a kernel on a VM or bare metal, where the
# condition holds and the unit loads modules as before.
#
# None of these four is masked: 'systemctl start' from a console still answers, and a
# container that has them pre-mounted by its runtime shows them active.
#
# SYSTEMD_DIR is a test hook; a build leaves it unset. tests/container-units.bats.

SYSTEMD_DIR=${SYSTEMD_DIR:-/etc/systemd/system}

NETWORKD="systemd-networkd.service systemd-networkd.socket
    systemd-networkd-wait-online.service"

# shellcheck disable=SC2086 # the unit names are the words of NETWORKD
systemctl disable $NETWORKD
for unit in $NETWORKD; do
    ln -sfn /dev/null "$SYSTEMD_DIR/$unit"
done

for unit in ntpsec.service sys-kernel-config.mount sys-kernel-debug.mount \
    systemd-modules-load.service; do
    mkdir -p "$SYSTEMD_DIR/$unit.d"
    cat > "$SYSTEMD_DIR/$unit.d/keel-container.conf" <<CONF
[Unit]
ConditionVirtualization=!container
CONF
done
