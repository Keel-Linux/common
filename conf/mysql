#!/bin/bash -e
#
# mysqltuner is not downloaded here. This script fetched mysqltuner.pl,
# basic_passwords.txt and vulnerabilities.csv from the master branch of
# jmrenouard/MySQLTuner-perl into /usr/local/bin: whatever that branch held
# on the day of the build, unpinned and unchecked. Debian trixie packages it
# (mysqltuner 2.6.0), so plans/turnkey/mysql names it and apt verifies it.
# The package installs /usr/bin/mysqltuner and keeps the two data files in
# /usr/share/mysqltuner, where it looks for them. tests/mysql-conf.bats fails
# if this script fetches anything again.
#
# INITD is an overridable default so the script can be run against a scratch
# directory and measured (decision 0004). A build does not set it.

INITD="${INITD:-/etc/init.d}"

# As of Debian Buster, there is no longer a /etc/init.d/mysql script, so let's
# link the mariadb one.
ln -s "$INITD/mariadb" "$INITD/mysql"

# secure mysql installation
service mysql start
mysql <<EOF
USE mysql;
# remove anonymous users
DELETE FROM user WHERE User='';

# remove remote root
DELETE FROM user WHERE User='root' AND Host NOT IN ('localhost', '127.0.0.1', '::1');

# remove test database
DROP DATABASE IF EXISTS test;
DELETE FROM db WHERE Db='test' OR Db='test\\_%';
EOF
service mysql stop
