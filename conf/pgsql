#!/bin/sh -ex
#
# No password is set here, for any role. This script gave the postgres role
# ${PGSQL_PASS:=postgres}, so a layer built with nothing declared shipped the
# superuser password 'postgres', and a layer is fetched by name and reused:
# every appliance built on it carried the same known password, and one whose
# first boot failed kept it. The cluster is created fresh below, so the role
# has no password and authenticates nothing over TCP until
# firstboot.d/35pgsqlpass (overlays/pgsql) sets the real one from DB_PASS.
# mk/turnkey/pgsql.mk no longer passes PGSQL_PASS in, and
# tests/pgsql-conf.bats fails if a password setting comes back.
#
# The two directory roots are overridable defaults so the script can be run
# against scratch directories and measured (decision 0004). A build sets
# neither.

PG_LIB_DIR="${PG_LIB_DIR:-/usr/lib/postgresql}"
PG_CONF_ROOT="${PG_CONF_ROOT:-/etc/postgresql}"

PGSQL_VER=$(ls $PG_LIB_DIR/)
CONF_DIR=$PG_CONF_ROOT/${PGSQL_VER}/main

# Recreate postgres and templates using UTF-8
pg_dropcluster --stop ${PGSQL_VER} main || true
pg_createcluster -e UTF-8 ${PGSQL_VER} main
systemctl start postgresql

# Enable password encryption
sed -i "/^#password_encryption = on/ s/#//" $CONF_DIR/postgresql.conf

# Reduce shared_buffers (better than increasing /proc/sys/kernel/shmmax)
sed -i "/^shared_buffers =/ s/32/24/" $CONF_DIR/postgresql.conf

# Reload config after changes
systemctl restart postgresql

# give user root superuser privileges over postgres
su postgres -c "createuser --superuser root"
su postgres -c "createdb root"

systemctl stop postgresql
