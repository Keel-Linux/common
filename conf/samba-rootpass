#!/bin/bash -e

# set samba root password
#
# The same account field as conf/turnkey.d/rootpass writes, for the same
# reason: '*' is a field no password matches, through any PAM stack, until
# the first boot sets a password over it. The old value, 'U6aMy0wojraho',
# is what crypt() returns for the empty string, and a stack carrying nullok
# (Debian's common-auth does) let any password in against it.
#
# No xtrace: it printed ROOT_PASS into the build log.
#
# 'smbpasswd -n' gives the Samba account a null password, which Samba
# refuses to authenticate unless 'null passwords = yes' is set in smb.conf;
# nothing in this tree sets it. That call is unchanged.
NO_PASSWORD='*'

passwd --unlock root                      # useful when testing in chroot

# A build time ROOT_PASS is not used, as in conf/turnkey.d/rootpass: the
# image ships both accounts without a password, and the first boot sets
# them (overlays/samba-fileserver, 35samba-*).
if [ -n "$ROOT_PASS" ]; then
    echo "samba-rootpass: ROOT_PASS is ignored; the image ships root locked" >&2
fi

usermod -p "$NO_PASSWORD" root
smbpasswd -a -n root
