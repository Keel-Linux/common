#!/usr/bin/env bats
# Tests for mk/turnkey/bootstrap-resolv, run in bootstrap/post: it gives
# the build chroot the resolvers of the build host.
#
# Why: the recipe wrote the IPv4-only public resolvers 8.8.8.8 and 8.8.4.4,
# so a build host with no IPv4 route could not resolve names in the chroot,
# and every build sent its queries to a third party.

bats_require_minimum_version 1.5.0

setup() {
    SCRIPT="$BATS_TEST_DIRNAME/../mk/turnkey/bootstrap-resolv"
    ROOTFS=$BATS_TEST_TMPDIR/rootfs
    HOST=$BATS_TEST_TMPDIR/host-resolv.conf
    mkdir -p "$ROOTFS/etc"
    cat > "$HOST" <<'EOF'
# Dynamic resolv.conf(5) file generated by resolvconf(8)
nameserver 2001:db8::53
nameserver 2001:db8::54
search example.org
options timeout:1
EOF
}

@test "copies the host's nameserver, search and options lines" {
    run "$SCRIPT" "$ROOTFS" "$HOST"
    [ "$status" -eq 0 ]
    [ "$(cat "$ROOTFS/etc/resolv.conf")" = "$(printf 'nameserver 2001:db8::53\nnameserver 2001:db8::54\nsearch example.org\noptions timeout:1')" ]
    [[ "$output" == *"2 nameserver(s)"* ]]
}

@test "writes no public IPv4 resolver" {
    run "$SCRIPT" "$ROOTFS" "$HOST"
    [ "$status" -eq 0 ]
    run ! grep -qE '8\.8\.8\.8|8\.8\.4\.4' "$ROOTFS/etc/resolv.conf"
}

@test "the file is a plain 0644 file" {
    "$SCRIPT" "$ROOTFS" "$HOST"
    [ -f "$ROOTFS/etc/resolv.conf" ]
    [ ! -L "$ROOTFS/etc/resolv.conf" ]
    [ "$(stat -c %a "$ROOTFS/etc/resolv.conf")" = 644 ]
}

@test "a link in ROOTFS is replaced, its target is not written" {
    target=$BATS_TEST_TMPDIR/outside
    echo "keep" > "$target"
    ln -s "$target" "$ROOTFS/etc/resolv.conf"
    run "$SCRIPT" "$ROOTFS" "$HOST"
    [ "$status" -eq 0 ]
    [ "$(cat "$target")" = keep ]
    [ ! -L "$ROOTFS/etc/resolv.conf" ]
}

@test "a host file with no nameserver fails" {
    printf 'search example.org\n' > "$HOST"
    run "$SCRIPT" "$ROOTFS" "$HOST"
    [ "$status" -eq 1 ]
    [[ "$output" == *"names no nameserver"* ]]
}

@test "an empty host file fails" {
    : > "$HOST"
    run "$SCRIPT" "$ROOTFS" "$HOST"
    [ "$status" -eq 1 ]
}

@test "a host file that does not exist fails" {
    run "$SCRIPT" "$ROOTFS" "$BATS_TEST_TMPDIR/none"
    [ "$status" -eq 1 ]
}

@test "the default host file is /etc/resolv.conf" {
    grep -q 'host_resolv=${2:-/etc/resolv.conf}' "$SCRIPT"
}

@test "bad usage exits 2" {
    run "$SCRIPT"
    [ "$status" -eq 2 ]
    run "$SCRIPT" "$BATS_TEST_TMPDIR/none" "$HOST"
    [ "$status" -eq 2 ]
}

@test "neither makefile writes a public resolver" {
    run ! grep -nE '8\.8\.8\.8|8\.8\.4\.4' \
        "$BATS_TEST_DIRNAME/../mk/turnkey.mk" \
        "$BATS_TEST_DIRNAME/../mk/turnkey-desktop.mk"
}

@test "both makefiles run bootstrap-resolv in bootstrap/post" {
    for mk in turnkey.mk turnkey-desktop.mk; do
        grep -qF '$(FAB_PATH)/common/mk/turnkey/bootstrap-resolv $O/bootstrap' \
            "$BATS_TEST_DIRNAME/../mk/$mk"
    done
}
